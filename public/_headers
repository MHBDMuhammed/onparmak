# Security headers for every response. The Content-Security-Policy itself
# lives only in the index.html meta tag so GitHub Pages keeps the identical
# policy; no CSP header is set here and values below must not contradict it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY

# Content-addressed build output: safe to cache for a year.
# (Placed after /* so the more specific rule wins.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable brand assets: cheap to revalidate, fresh within a day.
/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate
/og-image.png
  Cache-Control: public, max-age=86400, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

# App shell and worker: always revalidate so a new deployment activates
# promptly instead of serving a stale shell or worker script.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
