{
  "name": "onparmak",
  "private": true,
  "version": "1.0.0",
  "description": "Türkçe Q klavyede on parmak yazmayı öğreten, gizlilik odaklı ve çevrimdışı çalışabilen web uygulaması.",
  "license": "MIT",
  "author": "Muhammed Bodruk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MHBDMuhammed/onparmak.git"
  },
  "bugs": {
    "url": "https://github.com/MHBDMuhammed/onparmak/issues"
  },
  "homepage": "https://mhbdmuhammed.github.io/onparmak/",
  "keywords": [
    "typing",
    "touch-typing",
    "turkish",
    "keyboard",
    "education"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": ">=12.4.1 <13"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "pnpm typecheck && vite build --base=/onparmak/",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
